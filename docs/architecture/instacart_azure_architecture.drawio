=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="560" y="220" width="34" height="34" as="geometry"/></mxCell><mxCell id="p1_c81" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="440" y="838" width="34" height="34" as="geometry"/></mxCell><mxCell id="p1_c82" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1236" y="372" width="34" height="34" as="geometry"/></mxCell><mxCell id="p1_c83" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1236" y="572" width="34" height="34" as="geometry"/></mxCell><mxCell id="p1_c84" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1490" y="470" width="34" height="34" as="geometry"/></mxCell><mxCell id="p1_c85" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1752" y="372" width="34" height="34" as="geometry"/></mxCell><mxCell id="p1_c86" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1752" y="572" width="34" height="34" as="geometry"/></mxCell><mxCell id="p1_c87" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="2032" y="572" width="34" height="34" as="geometry"/></mxCell><mxCell id="p1_c88" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1845" y="818" width="34" height="34" as="geometry"/></mxCell><mxCell id="p1_c89" value="10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="2080" y="398" width="34" height="34" as="geometry"/></mxCell><mxCell id="p1_c90" value="11" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1020" y="205" width="34" height="34" as="geometry"/></mxCell><mxCell id="p1_c91" value="12" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="845" y="1436" width="34" height="34" as="geometry"/></mxCell><mxCell id="p1_c92" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;spacingBottom=12;fontSize=16;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1380" y="1430" width="1290" height="260" as="geometry"/></mxCell><mxCell id="p1_c93" value="&lt;b&gt;Luồng xử lý&lt;/b&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt; ADF copy dữ liệu batch (CSV Zenodo, bảng Azure SQL, REST API JSON + ảnh) vào &lt;i&gt;landing/&lt;/i&gt;&lt;br&gt;&lt;b&gt;2&lt;/b&gt; Simulator phát sự kiện đơn hàng (JSON) vào Event Hubs qua giao thức Kafka&lt;br&gt;&lt;b&gt;3&lt;/b&gt; Auto Loader nạp tăng dần &lt;i&gt;landing/&lt;/i&gt; → bảng Delta &lt;b&gt;bronze&lt;/b&gt;&lt;br&gt;&lt;b&gt;4&lt;/b&gt; Structured Streaming đọc Event Hubs → &lt;b&gt;bronze.order_events&lt;/b&gt; (checkpoint trên ADLS)&lt;br&gt;&lt;b&gt;5&lt;/b&gt; Spark ETL: làm sạch, chuẩn hóa schema, khử trùng, hợp nhất batch + stream → &lt;b&gt;silver&lt;/b&gt;, tạo &lt;b&gt;baskets&lt;/b&gt;&lt;br&gt;&lt;b&gt;6&lt;/b&gt; Tổng hợp KPI, đếm cặp sản phẩm (streaming theo cửa sổ) → &lt;b&gt;gold&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="1400" y="1442" width="640" height="240" as="geometry"/></mxCell><mxCell id="p1_c94" value="&lt;br&gt;&lt;b&gt;7&lt;/b&gt; Train FP-Growth (MLlib) và DApriori trên baskets &lt;i&gt;prior&lt;/i&gt;, thử nhiều minSupport / quy mô dữ liệu&lt;br&gt;&lt;b&gt;8&lt;/b&gt; Đánh giá luật trên tập holdout, log params/metrics/model vào MLflow, đăng ký model vào UC&lt;br&gt;&lt;b&gt;9&lt;/b&gt; Ghi frequent itemsets, association rules, metrics vào &lt;b&gt;gold&lt;/b&gt;&lt;br&gt;&lt;b&gt;10&lt;/b&gt; Databricks SQL Dashboard / Power BI đọc bảng gold&lt;br&gt;&lt;b&gt;11&lt;/b&gt; ADF chạy theo lịch, gọi Lakeflow Job điều phối bước 3 → 9&lt;br&gt;&lt;b&gt;12&lt;/b&gt; Benchmark MapReduce vs Spark chạy local, upload kết quả lên gold" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="2040" y="1442" width="620" height="160" as="geometry"/></mxCell><mxCell id="p1_c95" value="" style="point;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2040" y="1621" width="1" height="1" as="geometry"/></mxCell><mxCell id="p1_c96" value="" style="point;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2080" y="1621" width="1" height="1" as="geometry"/></mxCell><mxCell id="p1_c97" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;edgeStyle=none;" edge="1" parent="1" source="p1_c95" target="p1_c96"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_c98" value="Batch / ETL" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign