roundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="j1_c11" target="j1_c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="j1_c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#FF3621;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="j1_c9" target="j1_c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="j1_c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8E959C;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="j1_c12" target="j1_c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="j1_c25" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="380" y="268" width="34" height="34" as="geometry"/></mxCell><mxCell id="j1_c26" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="530" y="118" width="34" height="34" as="geometry"/></mxCell><mxCell id="j1_c27" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="730" y="268" width="34" height="34" as="geometry"/></mxCell><mxCell id="j1_c28" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1215" y="268" width="34" height="34" as="geometry"/></mxCell><mxCell id="j1_c29" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1810" y="258" width="34" height="34" as="geometry"/></mxCell><mxCell id="j1_c30" value="&lt;b&gt;1&lt;/b&gt; Crawler lấy các sản phẩm chưa tra&lt;br&gt;&lt;b&gt;2&lt;/b&gt; Gọi search API theo tên sản phẩm&lt;br&gt;&lt;b&gt;3&lt;/b&gt; Ghi JSON + ảnh vào landing, Auto Loader nạp bronze&lt;br&gt;&lt;b&gt;4&lt;/b&gt; Chấm điểm từng ứng viên&lt;br&gt;&lt;b&gt;5&lt;/b&gt; Giữ ứng viên điểm cao nhất của mỗi sản phẩm vào bảng cầu nối" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="560" height="100" as="geometry"/></mxCell><mxCell id="j1_c31" value="&lt;b&gt;Cách chấm điểm&lt;/b&gt;&lt;br&gt;① chuẩn hóa tên: chữ thường, bỏ dấu câu, bỏ &lt;i&gt;organic · bag of ·&lt;/i&gt; đơn vị đo&lt;br&gt;② chỉ giữ ứng viên có &lt;i&gt;countries_tags&lt;/i&gt; chứa en:united-states&lt;br&gt;③ rapidfuzz.token_set_ratio + điểm cộng nếu thương hiệu có trong tên" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="760" y="410" width="560" height="90" as="geometry"/></mxCell><mxCell id="j1_c32" value="B · Dựng silver.dim_product: mọi phép nối là LEFT JOIN, bảng gốc là products" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;spacingBottom=12;fontSize=16;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="1820" height="610" as="geometry"/></mxCell><mxCell id="j1_c33" value="&lt;b&gt;silver.dim_product&lt;/b&gt; (49.688 dòng)&lt;br&gt;&lt;br&gt;product_id · product_name&lt;br&gt;aisle · department&lt;br&gt;current_price&lt;br&gt;on_promotion · discount_pct&lt;br&gt;brand&lt;br&gt;nutriscore_grade · nova_group&lt;br&gt;energy_kcal / sugars / fat (100g)&lt;br&gt;off_categories · image_path&lt;br&gt;off_match_status · off_match_score" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E959C;strokeWidth=3;align=left;spacingLeft=10;fontSize=13;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="800" y="620" width="330" height="400" as="geometry"/></mxCell><mxCell id="j1_c34" value="&lt;b&gt;products&lt;/b&gt; · bảng gốc" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F7F7F;strokeWidth=1.5;align=left;spacingLeft=10;fontSize=13;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="90" y="636" width="260" height="48" as="geometry"/></mxCell><mxCell id="j1_c35" value="product_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.10;" edge="1" parent="1" source="j1_c34" target="j1_c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="j1_c36" value="&lt;b&gt;aisles&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F7F7F;strokeWidth=1.5;align=left;spacingLeft=10;fontSize=13;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="90" y="716" width="260" height="48" as="geometry"/></mxCell><mxCell id="j1_c37" value="aisle_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.30;" edge="1" parent="1" source="j1_c36" target="j1_c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="j1_c38" value="&lt;b&gt;departments&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F7F7F;strokeWidth=1.5;align=left;spacingLeft=10;fontSize=13;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="90" y="79