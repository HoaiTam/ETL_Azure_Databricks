eft;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="250" height="30" as="geometry"/></mxCell><mxCell id="e1_c53" value="&lt;b&gt;Bất biến&lt;/b&gt;: ghi _staging → công bố vào thư mục tất định → mốc (_SUCCESS / watermark) tăng sau cùng" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#0078D4;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="320" y="810" width="320" height="80" as="geometry"/></mxCell><mxCell id="e1_c54" value="&lt;b&gt;Chỉ append&lt;/b&gt;: checkpoint Auto Loader / Kafka; &lt;b&gt;pipelines.reset.allowed = false&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7EDE4;strokeColor=#B87333;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="670" y="810" width="320" height="80" as="geometry"/></mxCell><mxCell id="e1_c55" value="&lt;b&gt;Upsert theo khóa&lt;/b&gt;: AUTO CDC (KEYS + SEQUENCE BY); expectations + quarantine, không xóa im lặng" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F2F3;strokeColor=#8E959C;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1020" y="810" width="380" height="80" as="geometry"/></mxCell><mxCell id="e1_c56" value="&lt;b&gt;Tính lại được&lt;/b&gt;: materialized view; kiểm tra no-fanout trước khi dùng" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C9960C;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1430" y="810" width="340" height="80" as="geometry"/></mxCell><mxCell id="e1_c57" value="&lt;b&gt;Chỉ đọc&lt;/b&gt;: refresh sau khi &lt;b&gt;reconcile&lt;/b&gt; đạt; push gửi số tổng, gửi lại không sai" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C9960C;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1800" y="810" width="360" height="80" as="geometry"/></mxCell><mxCell id="e1_c58" value="Nguồn sự thật để phát lại stream là file order_products__train trên landing, không phải Event Hubs (bị xóa sau demo)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=2;fontColor=#545B64;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="2100" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="e2" name="CDC → SCD2"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="940" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="e2_c1" value="CDC từ Azure SQL đến lịch sử giá SCD Type 2" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontStyle=1;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2100" height="34" as="geometry"/></mxCell><mxCell id="e2_c2" value="Ví dụ sản phẩm 24852 (Banana) đổi giá 2 lần. Watermark (LSN) chỉ tăng sau khi dữ liệu đã được công bố lên landing." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#545B64;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="2100" height="24" as="geometry"/></mxCell><mxCell id="e2_c3" value="&lt;b&gt;dbo.product_prices&lt;/b&gt; (bảng hiện hành)&lt;br&gt;&lt;br&gt;&lt;span style='font-family:monospace;font-size:11px'&gt;INSERT 24852, 0.29, '2015-01-01'&lt;br&gt;UPDATE … 0.25, '2026-03-01'  &lt;i&gt;(wave 1)&lt;/i&gt;&lt;br&gt;UPDATE … 0.27, '2026-03-15'  &lt;i&gt;(wave 3)&lt;/i&gt;&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBECEC;strokeColor=#A4373A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="330" height="150" as="geometry"/></mxCell><mxCell id="e2_c4" value="&lt;b&gt;cdc.dbo_product_prices_CT&lt;/b&gt;&lt;br&gt;(SQL tự ghi từ transaction log)&lt;br&gt;&lt;br&gt;&lt;span style='font-family:monospace;font-size:11px'&gt;__$op  __$start_lsn  price&lt;br&gt;2      0x…0A1       0.29&lt;br&gt;4      0x…1F3       0.25&lt;br&gt;4      0x…2C8       0.27&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBECEC;strokeColor=#A4373A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="330" height="160" as="geometry"/></mxCell><mxCell id="e2_c5" value="capture" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#A4373A;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="e2_c3" target="e2_c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2_c6" value="ADF pl_cdc_one_table" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fontColor=#FFFFFF;strokeColor=none;fillColor=#0078D4;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="420" height="36" as="geometry"/></mxCell><mxCell id="e2_c7" value="&lt;b&gt;1. Lookup&lt;/b&gt; etl.usp_get_cdc_window&lt;br&gt;→ mode, from_lsn = last+1, to_lsn = max" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="430" y="160" width="420" height="64" as="geometry"/></mxCell><mxCell id="e2_c8" value="&lt;b&gt;2. Copy&lt;/b&gt; fn_cdc_get_all_changes(from, to, 'all')&lt;br&gt;→ landing/_staging/…" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="430" y="240" width="420" height="64" as="geometry"/></mxCell><mxCell id="e2_c9" value="&lt;b&gt;3. Công bố&lt;/b&gt;: chép sang &lt;b&gt;window=&amp;lt;from&amp;gt;_&amp;lt;to&amp;gt;&lt;/b&gt;/ · xóa staging" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="430" y="320" width="420" height="54" as="geometry"/></mxCell><mxCell id="e2_c10" value="&lt;b&gt;4. SP&lt;/b&gt; usp_set_cdc_watermark(to_lsn)&lt;br&gt;&lt;i&gt;chỉ chạy khi 1–3 thành công&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#0078D4;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="430" y="390" width="420" height="64" as="geometry"/></mxCell><mxCell id="e2_c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="e2_c7" target="e2_c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2_c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="e2_c8" target="e2_c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2_c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0078D4;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="e2_c9" target="e2_c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2_c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#A4373A;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="e2_c4" target="e2_c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2_c15" value="&lt;b&gt;Lỗi ở bước 2–3?&lt;/b&gt; watermark chưa tăng → chạy lại đọc đúng cửa sổ cũ.&lt;br&gt;&lt;b&gt;Lỗi ở bước 4?&lt;/b&gt; rerun from failed activity → giữ to_lsn cũ, chỉ chạy lại SP." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="430" y="480" width="420" height="80" as="geometry"/></mxCell><mxCell id="e2_c16" value="&lt;b&gt;bronze.product_prices_cdc&lt;/b&gt;&lt;br&gt;Auto Loader (Parquet), chỉ append&lt;br&gt;&lt;br&gt;&lt;span style='font-family:monospace;font-size:11px'&gt;_op _lsn    updated_at  price&lt;br&gt;0   0x…0A1 2015-01-01  0.29&lt;br&gt;4   0x…1F3 2026-03-01  0.25&lt;br&gt;4   0x…2C8 2026-03-15  0.27&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7EDE4;strokeColor=#B87333;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="910" y="160" width="360" height="170" as="geometry"/></mxCell><mxCell id="e2_c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B87333;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.6;" edge="1" parent="1" source="e2_c9" target="e2_c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2_c18" value="&lt;b&gt;view product_prices_changes&lt;/b&gt;&lt;br&gt;• expect_all_or_drop (giá &amp;gt; 0, USD)&lt;br&gt;• dropDuplicates(product_id, updated_at)&lt;br&gt;&lt;i&gt;→ đọc lặp do rerun không thành bản sao&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F2F3;strokeColor=#8E959C;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="910" y="380" width="360" height="110" as="geometry"/></mxCell><mxCell id="e2_c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8E959C;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="e2_c16" target="e2_c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2_c20" value="&lt;b&gt;AUTO CDC&lt;/b&gt;&lt;br&gt;KEYS (product_id)&lt;br&gt;SEQUENCE BY updated_at&lt;br&gt;APPLY AS DELETE WHEN _op = 1&lt;br&gt;STORED AS &lt;b&gt;SCD TYPE 2&lt;/b&gt;&lt;br&gt;TRACK HISTORY ON unit_price, currency" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#FF3621;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1330" y="160" width="330" height="170" as="geometry"/></mxCell><mxCell id="e2_c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#FF3621;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="e2_c18" target="e2_c20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="435"/><mxPoint x="1300" y="296"/></Array></mxGeometry></mxCell><mxCell id="e2_c22" value="&lt;b&gt;silver.product_prices_history&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-family:monospace;font-size:11px'&gt;price  __START_AT   __END_AT&lt;br&gt;0.29   2015-01-01   2026-03-01&lt;br&gt;0.25   2026-03-01   2026-03-15&lt;br&gt;0.27   2026-03-15   NULL  ← hiện hành&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F2F3;strokeColor=#8E959C;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1720" y="160" width="440" height="170" as="geometry"/></mxCell><mxCell id="e2_c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8E959C;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="e2_c20" target="e2_c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2_c24" value="&lt;b&gt;Point-in-time join&lt;/b&gt; (gold.fact_order_lines)&lt;br&gt;đơn đặt &lt;b&gt;2026-03-05&lt;/b&gt; → chọn phiên bản có&lt;br&gt;__START_AT ≤ order_ts_sim &amp;lt; __END_AT → &lt;b&gt;0.25&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C9960C;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1720" y="380" width="440" height="100" as="geometry"/></mxCell><mxCell id="e2_c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C9960C;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="e2_c22" target="e2_c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2_c26" value="So với cách khác" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fontColor=#FFFFFF;strokeColor=none;fillColor=#545B64;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="400" height="36" as="geometry"/></mxCell><mxCell id="e2_c27" value="&lt;b&gt;Watermark updated_at&lt;/b&gt;: không thấy DELETE, không thấy nhiều lần sửa giữa 2 lần chạy → dự phòng khi CDC không bật được (soft delete is_deleted)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#545B64;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="640" height="70" as="geometry"/></mxCell><mxCell id="e2_c28" value="&lt;b&gt;SCD Type 1&lt;/b&gt; (promotions): chỉ giữ bản mới nhất; SEQUENCE BY (_lsn, _seqval) vì dòng delete mang updated_at cũ." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#545B64;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="700" y="670" width="640" height="70" as="geometry"/></mxCell><mxCell id="e2_c29" value="&lt;b&gt;Quá retention 7 ngày&lt;/b&gt;: last_lsn &amp;lt; min_lsn → mode = snapshot (_op = 0) → AUTO CDC xem như upsert." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#545B64;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1360" y="670" width="640" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="e3" name="Chạy lại khi lỗi"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1100" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="e3_c1" value="Cây quyết định: lỗi ở đâu thì chạy lại thế nào để không mất, không trùng" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;fontStyle=1;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2100" height="34" as="geometry"/></mxCell><mxCell id="e3_c2" value="Repair/rerun không tự làm task idempotent. Chạy lại an toàn là nhờ quy tắc của từng tầng." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#545B64;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="2100" height="24" as="geometry"/></mxCell><mxCell id="e3_c3" value="&lt;b&gt;Có lỗi&lt;/b&gt; (ADF Monitor · Job run · event log)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=14;fontColor=#232F3E;strokeWidth=2;fillColor=#FDECEA;strokeColor=#C62828;" vertex="1" parent="1"><mxGeometry x="870" y="100" width="460" height="46" as="geometry"/></mxCell><mxCell id="e3_c4" value="&lt;b&gt;Lỗi ở tầng nào?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fontColor=#232F3E;strokeWidth=2;strokeColor=#232F3E;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="960" y="170" width="280" height="100" as="geometry"/></mxCell><mxCell id="e3_c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="e3_c3" target="e3_c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3_c6" value="Landing (ADF)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fontColor=#FFFFFF;strokeColor=none;fillColor=#0078D4;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="500" height="36" as="geometry"/></mxCell><mxCell id="e3_c7" value="Bronze" s