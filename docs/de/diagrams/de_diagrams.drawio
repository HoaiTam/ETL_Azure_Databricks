"/><mxPoint x="1370" y="290"/></Array></mxGeometry></mxCell><mxCell id="e3_c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="e3_c4" target="e3_c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="290"/><mxPoint x="1910" y="290"/></Array></mxGeometry></mxCell><mxCell id="e3_c14" value="Mốc đã tăng?&lt;br&gt;(_SUCCESS / watermark)" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontColor=#232F3E;strokeWidth=2;strokeColor=#0078D4;fillColor=#E8F1FB;" vertex="1" parent="1"><mxGeometry x="160" y="370" width="260" height="100" as="geometry"/></mxCell><mxCell id="e3_c15" value="&lt;b&gt;Không nạp lại.&lt;/b&gt; Nếu lỡ rerun &lt;i&gt;cả&lt;/i&gt; pipeline → thư mục window mới chứa thay đổi cũ → silver loại trùng" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="240" height="120" as="geometry"/></mxCell><mxCell id="e3_c16" value="&lt;b&gt;Rerun from failed activity&lt;/b&gt;&lt;br&gt;cùng cửa sổ LSN, cùng thư mục tất định; staging dở bị ghi đè" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#0078D4;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="300" y="520" width="240" height="120" as="geometry"/></mxCell><mxCell id="e3_c17" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2E7D32;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="e3_c14" target="e3_c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3_c18" value="không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C62828;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="e3_c14" target="e3_c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3_c19" value="OFF 429 → chạy lại crawler (trạng thái theo từng sản phẩm)&lt;br&gt;Seed wave → transaction + etl.seed_wave" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="500" height="64" as="geometry"/></mxCell><mxCell id="e3_c20" value="Update dừng&lt;br&gt;giữa chừng?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontColor=#232F3E;strokeWidth=2;strokeColor=#B87333;fillColor=#F7EDE4;" vertex="1" parent="1"><mxGeometry x="700" y="370" width="260" height="100" as="geometry"/></mxCell><mxCell id="e3_c21" value="&lt;b&gt;Repair run / chạy lại update&lt;/b&gt;&lt;br&gt;checkpoint bỏ micro-batch chưa commit" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="580" y="520" width="240" height="120" as="geometry"/></mxCell><mxCell id="e3_c22" value="Cần nạp lại 1 file? → chép sang &lt;b&gt;đường dẫn mới&lt;/b&gt;; silver upsert theo khóa" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7EDE4;strokeColor=#B87333;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="840" y="520" width="240" height="120" as="geometry"/></mxCell><mxCell i