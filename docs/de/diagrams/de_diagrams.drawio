28" value="&lt;b&gt;Dữ liệu&lt;/b&gt;: expect_or_fail dừng → sửa nguồn hoặc thêm luật quarantine → chạy lại update" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F2F3;strokeColor=#8E959C;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1380" y="520" width="240" height="120" as="geometry"/></mxCell><mxCell id="e3_c29" value="code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2E7D32;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="e3_c26" target="e3_c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3_c30" value="dữ liệu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C62828;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="e3_c26" target="e3_c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3_c31" value="Bảng do pipeline quản lý: &lt;b&gt;không&lt;/b&gt; RESTORE/UPDATE tay.&lt;br&gt;Bảng thường (ops.*): DESCRIBE HISTORY → RESTORE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E959C;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1120" y="670" width="500" height="64" as="geometry"/></mxCell><mxCell id="e3_c32" value="Event Hubs còn&lt;br&gt;giữ sự kiện?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontColor=#232F3E;strokeWidth=2;strokeColor=#3999C6;fillColor=#E8F4FA;" vertex="1" parent="1"><mxGeometry x="1780" y="370" width="260" height="100" as="geometry"/></mxCell><mxCell id="e3_c33" value="&lt;b&gt;Start lại pipeline&lt;/b&gt;&lt;br&gt;checkpoint Kafka đọc tiếp từ offset đã commit" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1660" y="520" width="240" height="120" as="geometry"/></mxCell><mxCell id="e3_c34" value="&lt;b&gt;stream-toggle up&lt;/b&gt; → &lt;b&gt;eh_generation&lt;/b&gt; mới (flow mới) → &lt;b&gt;phát lại&lt;/b&gt; simulator với run-id mới" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F4FA;strokeColor=#3999C6;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1920" y="520" width="240" height="120" as="geometry"/></mxCell><mxCell id="e3_c35" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2E7D32;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="e3_c32" target="e3_c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3_c36" value="không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C62828;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="e3_c32" target="e3_c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3_c37" value="AUTO CDC theo order_id: stream_orders vẫn 131.209;&lt;br&gt;bronze giữ mọi lần phát (theo replay_run_id)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3999C6;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1660" y="670" width="500" height="64" as="geometry"/></mxCell><mxCell id="e3_c38" value="&lt;b&gt;Luôn kết thúc bằng&lt;/b&gt;: task &lt;b&gt;reconcile&lt;/b&gt; → ops.reconciliation đạt → refresh_bi → dashboard" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=14;fontColor=#232F3E;strokeWidth=2;fillColor=#E8F5E9;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="540" y="830" width="1120" height="50" as="geometry"/></mxCell><mxCell id="e3_c39" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="289" y="734" width="2" height="2" as="geometry"/></mxCell><mxCell id="e3_c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="e3_c39" target="e3_c38"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="800"/><mxPoint x="1100" y="800"/></Array></mxGeometry></mxCell><mxCell id="e3_c41" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="829" y="734" width="2" height="2" as="geometry"/></mxCell><mxCell id="e3_c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="e3_c41" target="e3_c38"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="800"/><mxPoint x="1100" y="800"/></Array></mxGeometry></mxCell><mxCell id="e3_c43" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1369" y="734" width="2" height="2" as="geometry"/></mxCell><mxCell id="e3_c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#545B64;fontSize=12;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="e3_c43" target="e3_c38"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1370